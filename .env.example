# Copy to .env (git-ignored) and fill in. Used by docker compose, the API (Development only)
# and `dotnet ef`. Never commit real values. Other environments inject these as real env vars.

# --- Docker Compose: local PostgreSQL / Redis ---
POSTGRES_DB=rentapp
POSTGRES_USER=rentapp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API ---
# Keep the password in sync with POSTGRES_PASSWORD above.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=rentapp;Username=rentapp;Password=
REDIS_CONNECTION_STRING=localhost:6379

# JWT signing secret: at least 32 random bytes, e.g. PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=
JWT_ISSUER=rentapp-api
JWT_AUDIENCE=rentapp-mobile

# Comma-separated browser origins allowed by CORS. Leave empty: the mobile app does not need CORS.
CORS_ALLOWED_ORIGINS=
